@model Pagin_Web_Zoonosis.Models.EditarDuenoViewModel
@{
    ViewData["Title"] = "Editar dueño";
}

<div class="container mt-3" style="max-width: 600px;">
    <h3 class="fw-bold mb-3">Editar dueño</h3>
    <form asp-action="Editar" method="post">
        <input type="hidden" asp-for="IDdueño" />
        <div asp-validation-summary="All" class="alert alert-danger"></div>
        <div class="mb-3"><label class="form-label fw-bold">Nombre</label><input asp-for="Nombre" class="form-control" /></div>
        <div class="mb-3"><label class="form-label fw-bold">Apellido</label><input asp-for="Apellido" class="form-control" /></div>
        <div class="mb-3"><label class="form-label fw-bold">DNI</label><input asp-for="DNI" class="form-control" /></div>
        <div class="mb-3"><label class="form-label fw-bold">Dirección</label><input asp-for="Direccion" class="form-control" /></div>
        <div class="mb-3"><label class="form-label fw-bold">Barrio</label><input asp-for="Barrio" class="form-control" /></div>
        <div class="mb-3"><label class="form-label fw-bold">Teléfono</label><input asp-for="Telefono" class="form-control" /></div>
        <button class="btn btn-primary">💾 Guardar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>