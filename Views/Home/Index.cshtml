@{
    ViewData["Title"] = "Menú Principal";
}

<div class="container py-3">
    <h2 class="mb-4">Menú Principal - Fichas Clínicas</h2>

    <!-- Opción 1: Crear Ficha Clínica -->
    <a asp-controller="Fichas" asp-action="Crear" class="card shadow-sm text-decoration-none text-dark card-hover" style="margin-bottom: 50px;">
        <div class="card-body p-4 d-flex align-items-center justify-content-between">
            <h3 class="m-0 fs-4 fw-bold">➕ Crear Ficha Clínica</h3>
            <span class="text-primary fw-semibold">Ingresar &rarr;</span>
        </div>
    </a>
    <!-- Opción 2: Fichas Clínicas -->
    <a asp-controller="Fichas" asp-action="Index" class="card shadow-sm text-decoration-none text-dark card-hover" style="margin-bottom: 50px;">
        <div class="card-body p-4 d-flex align-items-center justify-content-between">
            <h3 class="m-0 fs-4 fw-bold">📋 Fichas Clínicas</h3>
            <span class="text-primary fw-semibold">Ingresar &rarr;</span>
        </div>
    </a>

    <!-- Opción 3: Fichas Clínicas Guardadas -->
    <a asp-controller="Home" asp-action="Index" class="card shadow-sm text-decoration-none text-dark card-hover">
        <div class="card-body p-4 d-flex align-items-center justify-content-between">
            <h3 class="m-0 fs-4 fw-bold">📁 Fichas Clínicas Guardadas</h3>
            <span class="text-primary fw-semibold">Ingresar &rarr;</span>
        </div>
    </a>
</div>
<!-- Estilo para efecto visual al pasar el cursor (Hover) -->
<style>
    .card-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-left: 5px solid #0d6efd;
    }
    .card-hover:hover {
        transform: translateY(-3px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        background-color: #f8f9fa;
    }
</style>