@model IEnumerable<Pagin_Web_Zoonosis.Models.FichaItemViewModel>

@{
    ViewData["Title"] = "Fichas Clínicas";
}

<div class="container my-4">
    <!-- Encabezado con Título y Botón para Crear Nueva Ficha -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-primary m-0">📁 Historial de Fichas Clínicas</h2>
            <p class="text-muted m-0">Consulte o busque fichas registradas en el sistema.</p>
        </div>
        <a asp-controller="Fichas" asp-action="Crear" class="btn btn-success btn-lg shadow-sm">
            ➕ Nueva Ficha
        </a>
    </div>

    <!-- Barra de Búsqueda por ID o Nombre -->
    <div class="card shadow-sm mb-4 bg-light border-0">
        <div class="card-body p-3">
            <form asp-controller="Fichas" asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-9 col-sm-8">
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted">🔍</span>
                        <input type="text" name="buscarQuery" value="@ViewBag.BuscarQuery" class="form-control form-control-lg" placeholder="Buscar por N° de Ficha (ID), Dueño o Mascota..." />
                    </div>
                </div>
                <div class="col-md-3 col-sm-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg w-100">Buscar</button>
                    @if (!string.IsNullOrEmpty(ViewBag.BuscarQuery as string))
                    {
                                <a asp-controller="Fichas" asp-action="Index" class="btn btn-outline-secondary btn-lg">Limpiar</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Grilla Estilo Álbum (Tarjetas) -->
    @if (!Model.Any())
    {
                <div class="text-center py-5">
                    <h4 class="text-muted">No se encontraron fichas clínicas registrada(s).</h4>
                    <p>Intente realizar otra búsqueda o cree una nueva ficha.</p>
                </div>
    }
    else
    {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var ficha in Model)
            {
                                <div class="col">
                                    <div class="card h-100 shadow-sm hover-shadow border-0 rounded-3">
                                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                                            <span class="badge bg-light text-primary font-monospace fs-6">
                                                N° #@ficha.Id.ToString("D4")
                                            </span>
                                            <small class="text-light">📅 @ficha.FechaConsulta</small>
                                        </div>
                                        <div class="card-body">
                                            <h5 class="card-title fw-bold text-dark mb-2">🐾 @ficha.MascotaNombre</h5>
                                            <p class="text-muted small mb-3">Raza: <strong>@ficha.Raza</strong></p>

                                            <hr class="my-2" />

                                            <p class="card-text mb-1">
                                                <span class="fw-semibold text-secondary">👤 Dueño:</span> @ficha.DuenoNombre
                                            </p>
                                        </div>
                                        <div class="card-footer bg-white border-0 pt-0 pb-3">
                                            <div class="d-grid gap-2">
                                                <a asp-controller="Fichas" asp-action="Detalles" asp-route-id="@ficha.Id" class="btn btn-outline-primary btn-sm">
                                                    👁️ Ver Ficha Completa
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
            }
                </div>
    }
</div>

<style>
    .hover-shadow {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-shadow:hover {
        transform: translateY(-4px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>