@model Pagin_Web_Zoonosis.Models.CrearFichaViewModel
@{
    ViewData["Title"] = "Nueva Ficha Clínica";
}

<div class="container mt-3">
    <div class="d-flex align-items-center gap-3 mb-4 pb-2 border-bottom">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Volver</a>
        <h3 class="m-0 fw-bold">Nueva Ficha Clínica</h3>
        <span class="text-muted ms-auto">N° de ficha y fecha: automáticos</span>
    </div>

    <form asp-action="Crear" method="post">
        <div asp-validation-summary="All" class="alert alert-danger"></div>

        @if (Model.DuenoExiste)
        {
                <div class="alert alert-success">Dueño encontrado. Podés elegir una de sus mascotas o cargar una nueva.</div>
        }
        else if (Model.DuenoBuscado)
        {
                <div class="alert alert-info">No hay ningún dueño con el DNI @Model.DuenoDni: se va a crear uno nuevo al guardar.</div>
        }

        @if (Model.Diferencias.Any())
        {
                <div class="alert alert-warning">
                    <h5 class="alert-heading">Los datos del dueño son distintos a los guardados</h5>
                    <table class="table table-sm bg-white mb-3">
                        <thead><tr><th>Campo</th><th>Guardado</th><th>Ingresado</th></tr></thead>
                        <tbody>
                        @foreach (var d in Model.Diferencias)
                        {
                                <tr><td>@d.Campo</td><td>@d.Actual</td><td>@d.Nuevo</td></tr>
                        }
                        </tbody>
                    </table>
                    <p class="mb-2">¿Querés actualizar los datos guardados?</p>
                    <button type="submit" name="DecisionDueno" value="actualizar" class="btn btn-warning">Sí, actualizar y crear la ficha</button>
                    <button type="submit" name="DecisionDueno" value="mantener" class="btn btn-outline-secondary">No, mantener los guardados y crear la ficha</button>
                </div>
        }

        <div class="row g-4">
            <!-- Dueño -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-primary text-white"><h4 class="m-0 fs-5">👤 Datos del Dueño</h4></div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">DNI</label>
                            <div class="input-group">
                                <input asp-for="DuenoDni" class="form-control" inputmode="numeric" placeholder="Ej: 12345678" />
                                <button type="button" class="btn btn-outline-primary"
                                        onclick="var f=this.form; f.action='@Url.Action("BuscarDueno", "Fichas")'; f.submit();">
                                    🔍 Buscar dueño
                                </button>
                            </div>
                            <div class="form-text">Opcional: si el dueño ya existe, completa sus datos y mascotas.</div>
                        </div>
                        <div class="mb-3"><label class="form-label fw-bold">Nombre</label><input asp-for="DuenoNombre" class="form-control" /></div>
                        <div class="mb-3"><label class="form-label fw-bold">Apellido</label><input asp-for="DuenoApellido" class="form-control" /></div>
                        <div class="mb-3"><label class="form-label fw-bold">Dirección</label><input asp-for="DuenoDireccion" class="form-control" /></div>
                        <div class="mb-3"><label class="form-label fw-bold">Barrio</label><input asp-for="DuenoBarrio" class="form-control" /></div>
                        <div class="mb-3"><label class="form-label fw-bold">Teléfono</label><input asp-for="DuenoTelefono" class="form-control" /></div>
                    </div>
                </div>
            </div>

            <!-- Mascota -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-success text-white"><h4 class="m-0 fs-5">🐾 Datos de la Mascota</h4></div>
                    <div class="card-body">
                        @if (Model.MascotasDelDueno.Any())
                        {
                                <p class="fw-bold mb-1">Mascotas de este dueño</p>
                            @foreach (var m in Model.MascotasDelDueno)
                            {
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" asp-for="MascotaId" value="@m.IDmascota" id="mascota_@m.IDmascota" />
                                            <label class="form-check-label" for="mascota_@m.IDmascota">@m.Nombre (@m.Especie, @m.Raza)</label>
                                        </div>
                            }
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="radio" asp-for="MascotaId" value="0" id="mascota_nueva" />
                                    <label class="form-check-label" for="mascota_nueva">Mascota nueva (completar los datos de abajo)</label>
                                </div>
                                <hr />
                        }

                        <div class="mb-3"><label class="form-label fw-bold">Nombre</label><input asp-for="MascotaNombre" class="form-control" /></div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label fw-bold">Especie</label>
                                <select asp-for="MascotaEspecie" class="form-select">
                                    <option value="">Seleccionar...</option>
                                    <option value="Perro">Perro</option>
                                    <option value="Gato">Gato</option>
                                    <option value="Otro">Otro</option>
                                </select>
                            </div>
                            <div class="col-6 mb-3"><label class="form-label fw-bold">Raza</label><input asp-for="MascotaRaza" class="form-control" /></div>
                        </div>
                        <div class="mb-3"><label class="form-label fw-bold">Fecha de nacimiento</label><input asp-for="MascotaFechaNacimiento" type="date" class="form-control" /></div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label fw-bold">Sexo</label>
                                <select asp-for="MascotaSexo" class="form-select">
                                    <option value="">Seleccionar...</option>
                                    <option value="Macho">Macho</option>
                                    <option value="Hembra">Hembra</option>
                                </select>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label fw-bold">¿Castrado?</label>
                                <select asp-for="MascotaCastrado" class="form-select">
                                    <option value="">Seleccionar...</option>
                                    <option value="true">Sí</option>
                                    <option value="false">No</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Visita -->
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white"><h4 class="m-0 fs-5">🩺 Datos de la visita</h4></div>
                    <div class="card-body">
                        <div class="mb-3"><label class="form-label fw-bold">Motivo de consulta</label><textarea asp-for="MotivoConsulta" class="form-control" rows="2"></textarea></div>
                        <div class="row">
                            <div class="col-md-6 mb-3"><label class="form-label fw-bold">Diagnóstico</label><textarea asp-for="Diagnostico" class="form-control" rows="3"></textarea></div>
                            <div class="col-md-6 mb-3"><label class="form-label fw-bold">Tratamiento</label><textarea asp-for="Tratamiento" class="form-control" rows="3"></textarea></div>
                        </div>
                        <div class="row">
                            <div class="col-md-9 mb-3"><label class="form-label fw-bold">Observaciones</label><textarea asp-for="Observaciones" class="form-control" rows="2"></textarea></div>
                            <div class="col-md-3 mb-3"><label class="form-label fw-bold">Peso (kg, opcional)</label><input asp-for="Peso" type="number" step="0.01" class="form-control" /></div>
                        </div>
                        <small class="text-muted">El veterinario a cargo se registra automáticamente solo si quien crea la ficha es veterinario.</small>
                    </div>
                </div>
            </div>
        </div>

        @if (!Model.Diferencias.Any())
        {
                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-primary btn-lg px-5">💾 Guardar Ficha</button>
                </div>
        }
    </form>
</div>